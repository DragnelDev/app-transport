# ---------- Servidor ----------
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ---------- Base de datos (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=transport
DB_PASSWORD=transport
DB_NAME=transport
# true crea/ajusta tablas automáticamente (solo desarrollo). En producción: false + migraciones
DB_SYNCHRONIZE=true

# ---------- Seguridad ----------
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=12h

# ---------- Usuario inicial (se crea solo si no hay usuarios) ----------
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_OFFICE=Oficina Provincia A
# true crea secretaria demo, 2 rutas y 2 camionetas de ejemplo
SEED_DEMO_DATA=true

# ---------- Pagos QR ----------
# mock = pasarela simulada (desarrollo)  |  http = adaptador HTTP a su banco/agregador
PAYMENT_PROVIDER=mock
PAYMENT_QR_EXPIRES_MINUTES=15
# Obligatorio con PAYMENT_PROVIDER=http. El banco firma el body con HMAC-SHA256 (header x-signature)
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_URL=
PAYMENT_API_KEY=

# ---------- WhatsApp ----------
# log = solo consola  |  meta = WhatsApp Business Cloud API  |  evolution = Evolution API autoalojada
WHATSAPP_PROVIDER=log
DEFAULT_COUNTRY_CODE=591
NOTIFY_PASSENGER_TICKET=true
WHATSAPP_META_PHONE_ID=
WHATSAPP_META_TOKEN=
WHATSAPP_META_VERSION=v20.0
WHATSAPP_EVOLUTION_URL=
WHATSAPP_EVOLUTION_INSTANCE=
WHATSAPP_EVOLUTION_APIKEY=
